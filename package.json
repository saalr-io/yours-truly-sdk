{
  "name": "@yours-truly/node",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the Yours Truly email API.",
  "license": "MIT",
  "author": "Saalr",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": ["email", "api", "sdk", "yours-truly", "transactional", "ses"],
  "repository": { "type": "git", "url": "git+https://github.com/saalr-io/yours-truly-sdk.git" },
  "homepage": "https://github.com/saalr-io/yours-truly-sdk#readme",
  "bugs": { "url": "https://github.com/saalr-io/yours-truly-sdk/issues" },
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
